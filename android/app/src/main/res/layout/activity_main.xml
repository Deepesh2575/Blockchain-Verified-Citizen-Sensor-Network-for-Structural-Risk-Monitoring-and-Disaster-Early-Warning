<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/textPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIH 2026"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart India Hackathon"
                android:textColor="@color/textSecondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCT Balance"
                android:textColor="@color/textSecondary"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/tvWalletBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,248.75 SCT"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/colorAccent" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Wallet Connected"
                    android:textColor="@color/colorAccent"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edge Node"
                        android:textColor="@color/textPrimary"
                        android:textSize="36sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.02" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_dot"
                            android:backgroundTint="@color/statusListening" />
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="ONLINE"
                            android:textColor="@color/statusListening"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-black" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="• Citizen Sensor Network"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:background="@color/cardBackground"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Node ID"
                        android:textColor="@color/textSecondary"
                        android:textSize="10sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EN-7F3C-9A2B"
                        android:textColor="@color/colorPrimary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>
            </LinearLayout>

            <!-- Accelerometer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Accelerometer"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp" />

                    <!-- X Axis -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="X axis"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                        <com.sih26223.app.view.WaveformView
                            android:id="@+id/waveX"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp" />
                        <TextView
                            android:id="@+id/tvValX"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0.128"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:gravity="end"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Y Axis -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Y axis"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                        <com.sih26223.app.view.WaveformView
                            android:id="@+id/waveY"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp" />
                        <TextView
                            android:id="@+id/tvValY"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="-0.073"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:gravity="end"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Z Axis -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="Z axis"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp" />
                        <com.sih26223.app.view.WaveformView
                            android:id="@+id/waveZ"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="8dp" />
                        <TextView
                            android:id="@+id/tvValZ"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="0.036"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:gravity="end"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sampling: 100 Hz  |  Range: ±2g"
                        android:textColor="@color/colorPrimary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Multi Modal Sensing Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Multi-Modal Sensing"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="2dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Real-time data streams from edge sensors"
                android:textColor="@color/textSecondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Multi Modal Sensors Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:baselineAligned="false"
                android:layout_marginBottom="16dp">

                <!-- Seismic -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardBackgroundColor="@color/cardBackgroundVariant"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/cardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seismic Wave"
                            android:textColor="@color/textPrimary"
                            android:textSize="10sp" />
                        <com.sih26223.app.view.WaveformView
                            android:id="@+id/waveMag"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginVertical="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PGA"
                            android:textColor="@color/textSecondary"
                            android:textSize="8sp" />
                        <TextView
                            android:id="@+id/tvValMag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.156g"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Acoustic -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardBackgroundColor="@color/cardBackgroundVariant"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/cardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Acoustic Spec"
                            android:textColor="@color/textPrimary"
                            android:textSize="10sp" />
                        <com.sih26223.app.view.WaveformView
                            android:id="@+id/waveAcoustic"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginVertical="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Peak"
                            android:textColor="@color/textSecondary"
                            android:textSize="8sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.12 kHz"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FFT -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="@color/cardBackgroundVariant"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/cardStroke"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FFT Analysis"
                            android:textColor="@color/textPrimary"
                            android:textSize="10sp" />
                        <com.sih26223.app.view.WaveformView
                            android:id="@+id/waveFft"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginVertical="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dominant"
                            android:textColor="@color/textSecondary"
                            android:textSize="8sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18.6 Hz"
                            android:textColor="@color/textPrimary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- BLE Mesh Network -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLE Mesh Network"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CONNECTED"
                                android:textColor="@color/statusListening"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp"
                                android:fontFamily="sans-serif-black" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 / 20 Nodes Online"
                                android:textColor="@color/textSecondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Topology Placeholder -->
                        <View
                            android:layout_width="120dp"
                            android:layout_height="60dp"
                            android:background="#2000E5FF" />
                    </LinearLayout>
                    
                    <!-- Hidden button just to preserve ID for MainActivity -->
                    <Button
                        android:id="@+id/btnRubbleMode"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="invisible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AR Evacuation -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnArEscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBackgroundVariant"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/neonPurple"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AR Evacuation"
                            android:textColor="@color/neonPurple"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to start AR guidance"
                            android:textColor="@color/textSecondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exits Detected: 2"
                            android:textColor="@color/textPrimary"
                            android:textSize="10sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Distance: 18m"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    
                    <View
                        android:layout_width="120dp"
                        android:layout_height="60dp"
                        android:background="#20B388FF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Federated Learning -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTriggerFL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cardBackground"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/cardStroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    
                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_status_dot"
                        android:backgroundTint="#2000E5FF" />
                        
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Federated Learning"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Global Model Sync • Round 23 of 50"
                            android:textColor="@color/textSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCAL MODEL"
                        android:textColor="@color/statusListening"
                        android:background="#1500E676"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textSize="8sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSensing"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="✨ START AI SENSING"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/btnStart"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp" />

            <!-- AI Logs -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI Sensing Logs"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />
                
            <ScrollView
                android:id="@+id/logScrollView"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@color/cardBackground"
                android:padding="8dp">
                
                <TextView
                    android:id="@+id/tvLogConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="edge-node:~$ system_init\n[INFO] Accelerometer stream active"
                    android:textColor="@color/neonGreen"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
